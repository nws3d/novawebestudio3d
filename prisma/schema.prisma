generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id          String   @id @default(cuid())
  nombre      String
  email       String
  telefono    String?
  mensaje     String
  tipoServicio String?
  createdAt   DateTime @default(now())
}